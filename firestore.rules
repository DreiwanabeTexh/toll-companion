rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ DEV ONLY: Writes temporarily allowed for local placeholder data seeding.
    // TODO(deploy): Revert all 'allow write' lines back to 'if false' before any public release.

    match /tollSegments/{doc} {
      allow read: if true;
      allow write: if true; // TODO(deploy): revert to 'if false'
    }

    match /routes/{doc} {
      allow read: if true;
      allow write: if true; // TODO(deploy): revert to 'if false'
    }

    match /emergencyContacts/{doc} {
      allow read: if true;
      allow write: if true; // TODO(deploy): revert to 'if false'
    }

    match /guideEntries/{doc} {
      allow read: if true;
      allow write: if true; // TODO(deploy): revert to 'if false'
    }

    match /checklistItems/{doc} {
      allow read: if true;
      allow write: if true; // TODO(deploy): revert to 'if false'
    }

    match /routeBriefings/{doc} {
      allow read: if true;
      allow write: if true; // TODO(deploy): revert to 'if false'
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
